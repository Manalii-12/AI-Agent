# Aura Skincare Backend - Environment Variables
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection URL (Supabase, Neon, or Render PostgreSQL)
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Example Render: postgres://user:pass@dpg-xxxx-a.oregon-postgres.render.com/auradb
DATABASE_URL="postgresql://postgres:password@localhost:5432/aura_skincare"

# Optional Cloud LLM API Keys
GROQ_API_KEY=""
OPENAI_API_KEY=""
